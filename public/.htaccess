# =============================================
# DAP CaseView - Hostinger (Apache) config
# =============================================

# --- 1. Force HTTPS -----------------------------------------------------------
RewriteEngine On
RewriteBase /

# Redirect any HTTP request to HTTPS (Hostinger sets HTTPS=on behind proxy)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 2. SPA routing (existing) -----------------------------------------------
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# --- 3. Security headers -----------------------------------------------------
<IfModule mod_headers.c>
    # Force browsers to use HTTPS for 2 years, include subdomains, allow preload list
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Disallow being framed (clickjacking protection)
    Header always set X-Frame-Options "DENY"

    # Don't let browsers MIME-sniff responses
    Header always set X-Content-Type-Options "nosniff"

    # Limit what the Referer header leaks to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Block access to browser APIs we don't use
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Content Security Policy
    # NOTE: replace <YOUR-PROJECT>.supabase.co with your actual Supabase project URL
    # (the host portion of VITE_SUPABASE_URL). The same host appears twice below:
    # once for REST/Auth (https://) and once for Realtime (wss://).
    Header always set Content-Security-Policy "default-src 'self'; \
        script-src 'self'; \
        style-src 'self' 'unsafe-inline'; \
        img-src 'self' data: blob: https://<YOUR-PROJECT>.supabase.co; \
        font-src 'self' data:; \
        connect-src 'self' https://<YOUR-PROJECT>.supabase.co wss://<YOUR-PROJECT>.supabase.co; \
        frame-ancestors 'none'; \
        base-uri 'self'; \
        form-action 'self'; \
        object-src 'none'; \
        upgrade-insecure-requests"

    # Remove the Server header if possible (Hostinger may overwrite)
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Cache static assets aggressively, HTML never
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|webp|ico|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# --- 4. Block access to dotfiles and source maps in production ---------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>
